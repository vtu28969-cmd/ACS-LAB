import java.util.Scanner;

public class CircularDeliveryRouteRepair {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] route = new int[n];

        for (int i = 0; i < n; i++) {
            route[i] = sc.nextInt();
        }

        System.out.println("Circular Delivery Route:");

        for (int i = 0; i < n; i++) {
            System.out.print(route[i] + " ");
        }

        System.out.println();

        System.out.println("Next Delivery Connections:");

        for (int i = 0; i < n; i++) {
            int next = route[(i + 1) % n];
            System.out.println(route[i] + " -> " + next);
        }

        sc.close();
    }
}
