class Solution {
    public void moveZeroes(int[] nums) {

        int nonZero = 0;

        // Move all non-zero elements to the front
        for (int i = 0; i < nums.length; i++) {

            if (nums[i] != 0) {
                nums[nonZero] = nums[i];
                nonZero++;
            }
        }

        // Fill remaining positions with zero
        while (nonZero < nums.length) {
            nums[nonZero] = 0;
            nonZero++;
        }
    }
}
